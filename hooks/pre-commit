#!/bin/sh
# madoqua shim. Patched: `madoqua install` writes a bare `exec madoqua run`,
# which needs an activated venv. Put the repo's .venv/bin on PATH first so
# madoqua and the tools it runs (ruff, ty, biston, zorilla) resolve.
root=$(git rev-parse --show-toplevel)
if [ -d "$root/.venv/bin" ]; then
  PATH="$root/.venv/bin:$PATH"
  export PATH
fi
exec madoqua run
