#!/bin/sh
# madoqua shim. `madoqua install` writes a bare `exec madoqua run`, which
# needs madoqua on PATH; from a shell without the venv active it fails with
# `madoqua: not found`. Prefer the repo's own .venv copy (madoqua >= 0.2.1
# then puts .venv/bin on PATH for the tools it runs).
root=$(git rev-parse --show-toplevel)
[ -x "$root/.venv/bin/madoqua" ] && exec "$root/.venv/bin/madoqua" run
exec madoqua run
